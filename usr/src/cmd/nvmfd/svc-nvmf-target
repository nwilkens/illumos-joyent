. /lib/svc/share/smf_include.sh

/usr/sbin/nvmfadm restore || exit $SMF_EXIT_ERR_FATAL

set -- -f
set -- "$@" -P "`/usr/bin/svcprop -p config/discovery_port $SMF_FMRI`"
set -- "$@" -p "`/usr/bin/svcprop -p config/io_port $SMF_FMRI`"
for addr in `/usr/bin/svcprop -p config/listen_addresses $SMF_FMRI`; do
	# svcprop prints an empty string as a pair of quotes.
	[ "$addr" = '""' ] || set -- "$@" -a "$addr"
done

exec /usr/sbin/nvmfd "$@"
