<include global_zone_only_component>
set name=pkg.fmri value=pkg:/driver/network/irdma@$(PKGVERS)
set name=pkg.summary value="Intel E800 Series RDMA Driver"
set name=pkg.description value="Intel E800 Series RDMA Function Driver"
set name=info.classification \
    value=org.opensolaris.category.2008:Drivers/Networking
set name=variant.arch value=i386
dir  path=kernel group=sys
dir  path=kernel/drv group=sys
dir  path=kernel/drv/$(ARCH64) group=sys
file path=kernel/drv/$(ARCH64)/irdma group=sys
file path=kernel/drv/irdma.conf group=sys
driver name=irdma perms="* 0600 root sys"
license lic_CDDL license=lic_CDDL
license usr/src/uts/common/io/irdma/core/THIRDPARTYLICENSE \
    license=usr/src/uts/common/io/irdma/core/THIRDPARTYLICENSE
depend fmri=driver/network/ice type=require
