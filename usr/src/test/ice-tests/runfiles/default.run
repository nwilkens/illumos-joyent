#
# Tests that need an ice device but no peer.  $ICE_TEST_LINK names the link;
# each test reports SKIP without it.  Run them through /opt/ice-tests/bin/icetest.
#

[DEFAULT]
pre =
verbose = False
quiet = False
timeout = 120
post =
outputdir = /var/tmp/test_results
user = root

[/opt/ice-tests/tests]
tests = ['attach', 'led', 'diag_ioctl.64']
